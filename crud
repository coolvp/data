import tkinter as tk
from tkinter import messagebox
import sqlite3

DB = "college.db"


def setup_db():
    conn = sqlite3.connect(DB)
    cur = conn.cursor()

    cur.execute("""
    CREATE TABLE IF NOT EXISTS students (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        branch TEXT,
        marks INTEGER
    )
    """)

    conn.commit()
    conn.close()


# CREATE
def add_student():
    name = name_var.get().strip()
    branch = branch_var.get().strip()
    marks = marks_var.get().strip()

    if not name or not marks:
        messagebox.showwarning(
            "Warning",
            "Name and marks are required"
        )
        return

    try:
        marks_value = int(marks)
    except ValueError:
        messagebox.showerror(
            "Error",
            "Marks must be an integer"
        )
        return

    conn = sqlite3.connect(DB)
    cur = conn.cursor()

    cur.execute(
        "INSERT INTO students (name, branch, marks) VALUES (?, ?, ?)",
        (name, branch, marks_value)
    )

    conn.commit()
    conn.close()

    clear_fields()
    load_students()


# READ
def load_students():
    listbox.delete(0, tk.END)

    conn = sqlite3.connect(DB)
    cur = conn.cursor()

    cur.execute(
        "SELECT id, name, branch, marks FROM students ORDER BY id"
    )

    for row in cur.fetchall():
        listbox.insert(tk.END, row)

    conn.close()


# Select student from Listbox
def select_student(event):
    selected = listbox.curselection()

    if not selected:
        return

    student = listbox.get(selected[0])

    name_var.set(student[1])
    branch_var.set(student[2])
    marks_var.set(student[3])


# UPDATE
def update_student():
    selected = listbox.curselection()

    if not selected:
        messagebox.showwarning(
            "Warning",
            "Please select a student to update"
        )
        return

    student = listbox.get(selected[0])
    student_id = student[0]

    name = name_var.get().strip()
    branch = branch_var.get().strip()
    marks = marks_var.get().strip()

    if not name or not marks:
        messagebox.showwarning(
            "Warning",
            "Name and marks are required"
        )
        return

    try:
        marks_value = int(marks)
    except ValueError:
        messagebox.showerror(
            "Error",
            "Marks must be an integer"
        )
        return

    conn = sqlite3.connect(DB)
    cur = conn.cursor()

    cur.execute(
        """
        UPDATE students
        SET name = ?, branch = ?, marks = ?
        WHERE id = ?
        """,
        (name, branch, marks_value, student_id)
    )

    conn.commit()
    conn.close()

    messagebox.showinfo(
        "Success",
        "Student updated successfully"
    )

    clear_fields()
    load_students()


# DELETE
def delete_student():
    selected = listbox.curselection()

    if not selected:
        messagebox.showwarning(
            "Warning",
            "Please select a student to delete"
        )
        return

    student = listbox.get(selected[0])
    student_id = student[0]

    # Ask for confirmation
    confirm = messagebox.askyesno(
        "Confirm Delete",
        "Are you sure you want to delete this student?"
    )

    if not confirm:
        return

    conn = sqlite3.connect(DB)
    cur = conn.cursor()

    cur.execute(
        "DELETE FROM students WHERE id = ?",
        (student_id,)
    )

    conn.commit()
    conn.close()

    messagebox.showinfo(
        "Success",
        "Student deleted successfully"
    )

    clear_fields()
    load_students()


# Clear form
def clear_fields():
    name_var.set("")
    branch_var.set("")
    marks_var.set("")


# Database setup
setup_db()


# Main window
root = tk.Tk()
root.title("Student SQLite GUI")
root.geometry("650x450")


# Variables
name_var = tk.StringVar()
branch_var = tk.StringVar()
marks_var = tk.StringVar()


# Form
form = tk.Frame(root)
form.pack(fill="x", padx=10, pady=10)


tk.Label(
    form,
    text="Name"
).grid(row=0, column=0)

tk.Entry(
    form,
    textvariable=name_var
).grid(row=0, column=1)


tk.Label(
    form,
    text="Branch"
).grid(row=1, column=0)

tk.Entry(
    form,
    textvariable=branch_var
).grid(row=1, column=1)


tk.Label(
    form,
    text="Marks"
).grid(row=2, column=0)

tk.Entry(
    form,
    textvariable=marks_var
).grid(row=2, column=1)


# Buttons
tk.Button(
    form,
    text="Add",
    command=add_student
).grid(
    row=3,
    column=0,
    pady=10
)


tk.Button(
    form,
    text="Update",
    command=update_student
).grid(
    row=3,
    column=1,
    pady=10
)


tk.Button(
    form,
    text="Delete",
    command=delete_student
).grid(
    row=3,
    column=2,
    columnspan=2,
    pady=5
)


# Listbox
listbox = tk.Listbox(root)

listbox.pack(
    fill="both",
    expand=True,
    padx=10,
    pady=10
)


# Select student when clicked
listbox.bind(
    "<<ListboxSelect>>",
    select_student
)


# Refresh button
tk.Button(
    root,
    text="Refresh",
    command=load_students
).pack()


# Load existing students
load_students()

root.mainloop()
